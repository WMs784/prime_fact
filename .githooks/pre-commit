#!/bin/sh
set -e

echo "--- dart format ---"
dart format --output=none --set-exit-if-changed . || {
  echo "Run 'dart format .' to fix the files above."
  exit 1
}
echo ""

echo "--- flutter analyze ---"
flutter analyze
echo ""

echo "--- flutter test ---"
flutter test
echo ""

echo "Pre-commit checks passed."
