<?xml version="1.0" encoding="UTF-8"?>
<mutations version="1.2">
  <files>
    <file>lib/calculator/judge.dart</file>
  </files>
  <commands>
    <!-- 通常は数秒で終わる。変異で無限ループになった場合はタイムアウト=検出扱い -->
    <command group="test" expected-return="0" timeout="30">flutter test test/judge_test.dart</command>
  </commands>
  <exclude>
    <token begin="//" end="\n"/>
    <regex pattern="/[*].*?[*]/" dotAll="true"/>
    <regex pattern="[\s]while[\s]*\(.*?\)[\s]*{" dotAll="true"/>
    <regex pattern="[\s]for[\s]*\(.*?\)[\s]*{" dotAll="true"/>
    <!-- 等価変異: バッチ内の複数因数を絞り込む高速化。外すと別の c で再試行するだけで結果は同じ -->
    <regex pattern="\sif \(d == n\) \{.*?while \(d == BigInt\.one\);\s*\}" dotAll="true"/>
    <!-- 等価変異: 時間の区切り（>= / > / ==）の境界は実時間なので決定的にテストできない -->
    <regex pattern="\sif \(watch\.elapsed &gt;= slice\) \{"/>
  </exclude>
  <!-- 合否は run.sh が生き残り数で決める（ここでは判定しない） -->
  <threshold failure="0"/>
</mutations>
