<?xml version="1.0" encoding="UTF-8"?>
<mutations version="1.2">
  <files>
    <file>lib/trivia.dart</file>
  </files>
  <commands>
    <!-- 通常は数秒で終わる。変異で無限ループになった場合はタイムアウト=検出扱い -->
    <command group="test" expected-return="0" timeout="30">flutter test test/trivia_test.dart</command>
  </commands>
  <exclude>
    <token begin="//" end="\n"/>
    <regex pattern="/[*].*?[*]/" dotAll="true"/>
    <regex pattern="[\s]while[\s]*\(.*?\)[\s]*{" dotAll="true"/>
    <regex pattern="[\s]for[\s]*\(.*?\)[\s]*{" dotAll="true"/>
    <!-- 等価変異: 奇数・6 未満を先に弾く高速化。外しても後続のループが false を返す -->
    <lines begin="46" end="46"/>
  </exclude>
  <threshold failure="70"/>
</mutations>
